# Postgres
POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/cosolvent
# Optional discrete settings if POSTGRES_DSN is not set
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cosolvent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=change-me-to-a-random-secret
SESSION_TTL_HOURS=72

# S3 Storage
S3_BUCKET=cosolvent-files
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# OpenAI (embeddings + LLM)
OPENAI_API_KEY=

# Cohere (reranking)
COHERE_API_KEY=

# Resend (email)
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com

# App
MARKETPLACE_CONFIG_PATH=marketplace.yaml
CORS_ORIGINS=["http://localhost:3000"]
DEBUG=false
# Onboarding v2 toggle (recommended true for local/dev; set false in production smoke period if needed)
ONBOARDING_V2_ENABLED=true
