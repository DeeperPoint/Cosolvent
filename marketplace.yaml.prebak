marketplace:
  name: Industrial Machinery Trade
  description: A thin-market marketplace for Industrial Machinery Trade.
  industry: Industrial Machinery Trade
participant_types:
- name: Seller
  slug: seller
  role: supply
  permissions:
    can_list: true
    can_search: false
    can_initiate_conversation: false
    can_receive_conversation: true
    can_share_private_assets: true
    requires_onboarding: true
    requires_approval: true
    visible_in_search: true
- name: Buyer
  slug: buyer
  role: demand
  permissions:
    can_list: false
    can_search: true
    can_initiate_conversation: true
    can_receive_conversation: true
    can_share_private_assets: false
    requires_onboarding: true
    requires_approval: true
    visible_in_search: false
- name: Service Provider
  slug: service_provider
  role: facilitator
  permissions:
    can_list: true
    can_search: false
    can_initiate_conversation: false
    can_receive_conversation: true
    can_share_private_assets: true
    requires_onboarding: true
    requires_approval: true
    visible_in_search: true
profile_schemas:
  seller:
    sections:
    - name: Company
      fields:
      - name: company_name
        label: Company Name
        type: text
        required: true
        visibility: public
        searchable: true
      - name: country
        label: Country
        type: select
        required: true
        options:
        - united_states
        - canada
        - mexico
        - germany
        - italy
        - japan
        - china
        - south_korea
        - india
        - brazil
        visibility: public
        searchable: true
      - name: description
        label: About
        type: rich_text
        required: false
        visibility: public
        searchable: true
    - name: Offering
      fields:
      - name: category
        label: Category
        type: multi_select
        required: true
        options:
        - construction
        - agriculture
        - manufacturing_cnc
        - material_handling
        - mining
        - power_generation
        - forestry
        - oil_and_gas
        visibility: public
        searchable: true
      - name: brand
        label: Brand
        type: multi_select
        required: true
        options:
        - caterpillar
        - komatsu
        - john_deere
        - volvo
        - hitachi
        - jcb
        - liebherr
        - doosan
        - mitsubishi
        visibility: public
        searchable: true
      - name: condition
        label: Condition
        type: select
        required: true
        options:
        - new
        - used
        - refurbished
        - parts_only
        visibility: public
        searchable: true
      - name: operating_hours
        label: Operating Hours
        type: number
        required: false
        visibility: public
        searchable: true
      - name: emissions_standard
        label: Emissions Standard
        type: select
        required: false
        options:
        - epa_tier_2
        - epa_tier_3
        - epa_tier_4
        - eu_stage_v
        visibility: public
        searchable: true
      - name: spec_sheets
        label: Spec Sheets / Documents
        type: files
        required: false
        accepted_types:
        - pdf
        visibility: private
        searchable: false
  buyer:
    sections:
    - name: Organization
      fields:
      - name: company_name
        label: Organization Name
        type: text
        required: true
        visibility: public
        searchable: true
      - name: country
        label: Country
        type: select
        required: true
        options:
        - united_states
        - canada
        - mexico
        - germany
        - italy
        - japan
        - china
        - south_korea
        - india
        - brazil
        visibility: public
        searchable: true
      - name: description
        label: About
        type: rich_text
        required: false
        visibility: public
        searchable: true
    - name: Requirements
      fields:
      - name: category
        label: Category
        type: multi_select
        required: true
        options:
        - construction
        - agriculture
        - manufacturing_cnc
        - material_handling
        - mining
        - power_generation
        - forestry
        - oil_and_gas
        visibility: protected
        searchable: true
      - name: brand
        label: Brand
        type: multi_select
        required: true
        options:
        - caterpillar
        - komatsu
        - john_deere
        - volvo
        - hitachi
        - jcb
        - liebherr
        - doosan
        - mitsubishi
        visibility: protected
        searchable: true
      - name: condition
        label: Condition
        type: select
        required: true
        options:
        - new
        - used
        - refurbished
        - parts_only
        visibility: protected
        searchable: true
      - name: operating_hours
        label: Operating Hours
        type: number
        required: false
        visibility: protected
        searchable: true
      - name: emissions_standard
        label: Emissions Standard
        type: select
        required: false
        options:
        - epa_tier_2
        - epa_tier_3
        - epa_tier_4
        - eu_stage_v
        visibility: protected
        searchable: true
      - name: budget_range
        label: Typical Budget per Order
        type: select
        required: false
        options:
        - Under 25k
        - 25k-100k
        - 100k-500k
        - 500k-2M
        - 2M+
        visibility: protected
        searchable: false
  service_provider:
    sections:
    - name: Company
      fields:
      - name: company_name
        label: Company Name
        type: text
        required: true
        visibility: public
        searchable: true
      - name: country
        label: Country
        type: select
        required: true
        options:
        - united_states
        - canada
        - mexico
        - germany
        - italy
        - japan
        - china
        - south_korea
        - india
        - brazil
        visibility: public
        searchable: true
      - name: description
        label: About
        type: rich_text
        required: false
        visibility: public
        searchable: true
    - name: Services
      fields:
      - name: services_offered
        label: Services Offered
        type: multi_select
        required: true
        options:
        - Transport Carrier
        - Rigging Heavy Lift Specialist
        - Machinery Inspector
        - Customs Broker
        - Cargo Insurer
        visibility: public
        searchable: true
      - name: service_regions
        label: Service Regions
        type: multi_select
        required: true
        options:
        - North America
        - South America
        - Europe
        - Middle East
        - Africa
        - South Asia
        - East Asia
        - Southeast Asia
        - Oceania
        visibility: public
        searchable: true
      - name: equipment_type
        label: Equipment Type
        type: multi_select
        required: false
        options:
        - flatbed
        - step_deck
        - double_drop_lowboy
        - removable_gooseneck_rgn
        - container
        - roll_on_roll_off
        - heavy_haul_specialized
        visibility: public
        searchable: true
      - name: service_region
        label: Service Region
        type: select
        required: false
        options:
        - north_america
        - south_america
        - europe
        - middle_east
        - africa
        - south_asia
        - east_asia
        - southeast_asia
        - oceania
        visibility: public
        searchable: true
      - name: carrier_credentials
        label: Carrier Credentials
        type: multi_select
        required: false
        options:
        - dot_compliant
        - adr
        - tir_carnet
        - iso_9001
        - c_tpat
        visibility: public
        searchable: true
      - name: cargo_insurance_usd
        label: Cargo Insurance (USD)
        type: number
        required: false
        visibility: protected
        searchable: true
      - name: credentials
        label: Credentials / Certificates
        type: files
        required: false
        accepted_types:
        - pdf
        visibility: private
        searchable: false
onboarding:
  seller:
    requires_approval: true
    approval_type: manual
    document_upload_required: true
    ai_extraction_enabled: true
    ai_profile_generation: true
    welcome_email_on_approval: true
    profile_completeness_threshold: 80
  buyer:
    requires_approval: true
    approval_type: manual
    document_upload_required: false
    ai_extraction_enabled: false
    ai_profile_generation: false
    welcome_email_on_approval: true
    profile_completeness_threshold: 70
  service_provider:
    requires_approval: true
    approval_type: manual
    document_upload_required: true
    ai_extraction_enabled: true
    ai_profile_generation: true
    welcome_email_on_approval: true
    profile_completeness_threshold: 80
communication:
  conversation_rules:
  - initiator: buyer
    receiver: seller
    requires_approval: true
  - initiator: buyer
    receiver: service_provider
    requires_approval: true
discovery:
  searchable_types:
  - seller
  - service_provider
  filter_fields:
  - country
  - category
  - brand
  - condition
  - emissions_standard
  - services_offered
  - service_regions
  - equipment_type
  result_visibility:
    anonymous: public
    authenticated: protected
  ai:
    vector_search_enabled: true
    rag_query_enabled: true
    follow_up_suggestions: true
    profile_retrieval_mode: hybrid
    rag_failure_behavior: empty
    profile_similarity_threshold: 0.25
    max_vector_candidates: 500
  # GAP-3: config-driven weighted-slot scoring + hard gates over semantic similarity.
  # composite = vector_weight*vector + Σ slot.weight*slot_score; hard-gate failures
  # exclude a candidate from the ranked list (returned separately with the reason).
  # Per profile, vector_weight + Σ slot weights must sum to 1.0.
  matching:
    per_target:
      seller:
        vector_weight: 0.5
        slots:
        - name: category_fit
          fields: [category]
          comparator: jaccard
          weight: 0.25
        - name: brand_fit
          fields: [brand]
          comparator: jaccard
          weight: 0.12
        - name: same_country
          fields: [country]
          comparator: scalar_eq
          weight: 0.08
        - name: condition_fit
          fields: [condition]
          comparator: scalar_eq
          weight: 0.05
        hard_gates:
        - name: working_machines_only
          field: condition
          op: in
          value: [new, used, refurbished]
      buyer:
        vector_weight: 0.5
        slots:
        - name: category_fit
          fields: [category]
          comparator: jaccard
          weight: 0.25
        - name: brand_fit
          fields: [brand]
          comparator: jaccard
          weight: 0.12
        - name: same_country
          fields: [country]
          comparator: scalar_eq
          weight: 0.08
        - name: condition_fit
          fields: [condition]
          comparator: scalar_eq
          weight: 0.05
  access:
    anonymous_search_enabled: true
    anonymous_filter_mode: public_only
ai:
  enabled_providers:
  - openai
auth:
  allow_public_signup: false
  allow_public_application: true
